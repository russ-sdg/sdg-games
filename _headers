# Cloudflare Pages: always revalidate the online game's files (a cheap 304 when nothing changed), so a
# browser never keeps running an old copy of the game after an update.
/JfP/play/*
  Cache-Control: no-cache

# Product pages: the shared stylesheet/scripts and the pages themselves always revalidate, so a launch-day edit
# (price, buy button) reaches visitors straight away.
